# Always save exact dependency versions
save-exact=true

# Use the public npm registry
registry=https://registry.npmjs.org/

# Ensure scoped packages resolve to npm (not private registry)
@tectonic-technologies:registry=https://registry.npmjs.org/

# Auth token (resolved at runtime from environment variable)
# DO NOT hardcode the token here
//registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}